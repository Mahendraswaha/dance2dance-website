rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================================
    // FUNÇÃO AUXILIAR: Verifica se o usuário é Admin/Instrutor
    // ==========================================================
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['mahendra.swaha@gmail.com', 'contato@dance2dance.no'] || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'instructor']
      );
    }
    
    // ==========================================================
    // 1. Coleção 'users' (Perfis de usuário)
    // ==========================================================
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // ==========================================================
    // 2. Coleção 'events' (Agenda / Workshops)
    // ==========================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledCount', 'waitlistCount'])
      );
    }
    
    // ==========================================================
    // 3. Coleção 'enrollments' (Inscrições nos Workshops)
    // ==========================================================
    match /enrollments/{enrollmentId} {
      // Leitura: O aluno vê as próprias OR precisa ler a lista de espera para promovê-los
      allow read: if true;
      
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      
      // Deleção: Aluno deleta a dele
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Update: Aluno atualiza a dele OR promove o próximo da lista de espera
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && 
          request.resource.data.status == 'enrolled' && 
          resource.data.status == 'waitlist'
        )
      );
    }
    
    // ==========================================================
    // 4. Coleção 'wishlists' (Listas de Interesse / Vote)
    // ==========================================================
    match /wishlists/{wishlistId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ==========================================================
    // 5. Coleção 'contacts' (Mensagens do Formulário de Contato)
    // ==========================================================
    match /crm_email_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // ==========================================================
    // 6. Coleção 'reviews' (Depoimentos dos alunos)
    // ==========================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}









